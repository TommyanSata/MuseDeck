{
  "name": "fmc-feishu-muse-commander",
  "version": "0.7.0",
  "description": "MuseDeck - Multi-CLI AI Orchestration & Feishu/Muse Desktop Workbench",
  "author": "MuseDeck",
  "main": "dist-electron/main.js",
  "private": false,
  "license": "MIT",
  "scripts": {
    "dev:vite": "vite --port 5173",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:web": "vite build",
    "build": "npm run build:web && npm run build:electron",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "start": "npm run build && electron .",
    "dev": "npm run build:electron && concurrently -k \"npm run dev:vite\" \"wait-on http://127.0.0.1:5173 && cross-env FMC_DEV_URL=http://127.0.0.1:5173 electron .\""
  },
  "build": {
    "appId": "com.musedeck.desktop",
    "productName": "MuseDeck",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "fmc-tsnet.exe",
          "direct_v6_proxy.py"
        ]
      },
      {
        "from": "build",
        "to": "build",
        "filter": [
          "icon.ico",
          "icon.png"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MuseDeck",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "MuseDeck-Setup-${version}.exe"
    }
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.50.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  }
}
